diff --git a/src/calc.ts b/src/calc.ts
index 3bd1f2e..8a9c4d1 100644
--- a/src/calc.ts
+++ b/src/calc.ts
@@ -10,8 +10,12 @@ export function split(total: number, n: number) {
   if (!Number.isFinite(total)) {
     throw new Error('总金额必须是数字');
   }
-  const even = total / n;
+  if (n <= 0) {
+    throw new Error('人数必须为正数');
+  }
+  const even = Math.round((total / n) * 100) / 100;
+  const remainder = Math.round((total - even * n) * 100) / 100;
   const parts = new Array(n).fill(even);
   parts[n - 1] = even + remainder;
   return parts;
 }
